# Este arquivo mora na RAIZ do repositório. O Next leria .env de apps/web, então
# next.config.ts carrega este daqui de propósito; os scripts usam --env-file.
#
# --- LLM. Dois provedores; o Gemini ganha quando as duas chaves existem. ---
#
# A diferença que importa é o teto diário: os modelos gratuitos do OpenRouter
# dão 50 requisições por dia, o que o processamento contínuo gasta em menos de
# uma hora. O nível gratuito do Gemini dá algumas centenas por modelo por dia.
#
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=

# Force um provedor: "gemini" ou "openrouter". Sem isso, o Gemini tem prioridade.
# LLM_PROVIDER=gemini

# Sobrescreve os modelos por tarefa. Rode sem isso primeiro: os padrões são :free.
# OPENROUTER_MODEL_COMPILE=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_SUGGEST=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_SCORE=google/gemma-4-26b-a4b-it:free

# Teto local de requisições por dia. Sem isso, o padrão acompanha o provedor:
# 1.000 no Gemini, 50 no OpenRouter (ou 1.000 se a conta comprou 10 créditos).
# É um freio local — o provedor continua impondo o dele.
# LLM_DAILY_REQUESTS=1000

# Sobrescreve os modelos por tarefa.
# GEMINI_MODEL_SCORE=gemini-flash-lite-latest
# GEMINI_MODEL_COMPILE=gemini-flash-latest

# --- opcional: Google Places. É a ÚNICA etapa que gasta dinheiro. ---
# A Receita não tem campo de site; esta é a forma de descobrir um. Desligada por padrão.
# GOOGLE_MAPS_API_KEY=

# --- caminhos (padrão: a raiz do repositório) ---
# CNPJ_DATA_DIR=./data
# CNPJ_DB_PATH=./app.db
